    "start": "next start",
    "lint": "next lint",
    "preinstall": "node scripts/check-node-version.mjs",
    "install:anynode": "node scripts/run-with-node.mjs install",
    "dev:anynode": "node scripts/run-with-node.mjs dev",
    "install:docker": "node scripts/run-docker.mjs install",
    "dev:docker": "node scripts/run-docker.mjs dev",
    "deploy:actions": "hardhat run scripts/deploy-actions.ts --network base",
