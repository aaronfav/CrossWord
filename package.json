    "@metamask/sdk": "~0.33.1",
    "@tanstack/react-query": "^5.81.5",
    "next": "15.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.31.6",
    "wagmi": "^2.16.3",
    "word-list": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/eslint-plugin-next": "^15.3.4",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "hardhat": "^2.22.8",
    "sharp": "^0.33.5",
    "typescript": "^5",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20 <23"
  }
