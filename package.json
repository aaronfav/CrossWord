{
  "name": "crossword",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "node scripts/generate-brand-assets.mjs && node scripts/sync-wordlist.mjs",
